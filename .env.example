# PostgreSQL connection string used by Prisma.
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yunque_marketing_assistant?schema=public"
DATABASE_URL=""

# Server port used by Next.js / PM2. Nginx will proxy public traffic to it.
PORT="3000"

# Optional direct database URL for production migrations when your provider
# gives separate pooled and direct connection strings.
# If you use it, keep DATABASE_URL for app runtime and use DIRECT_URL manually
# when running prisma migrate deploy.
DIRECT_URL=""

# AI provider. Use "openai" or "deepseek".
AI_PROVIDER="openai"

# OpenAI API configuration.
OPENAI_API_KEY=""
# Optional. The app falls back to the model configured in src/services/ai/index.ts.
OPENAI_MODEL=""

# DeepSeek API configuration.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Supabase Auth public keys.
# Required when enabling login/register in production.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Development only. When Supabase Auth is not configured locally, the app can
# read this seeded user so you can preview database-backed pages.
DEV_AUTH_FALLBACK_EMAIL="mia@yunque.example"

# Local demo only. Set to "true" when running `next start` behind a tunnel
# before Supabase Auth is configured, so the production build can still use
# the seeded user/workspace.
ENABLE_DEV_AUTH_FALLBACK="false"
